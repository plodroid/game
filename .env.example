# CHROMASHIFT configuration. Copy to `.env` (never commit `.env`).
# Everything is optional: with no configuration the game runs fully offline,
# with guest profiles, and the server accepts guests.

# ---------------------------------------------------------------------------
# Web client — PUBLIC values baked into the static build (GitHub Pages).
# Firebase web config identifies your project; it is designed to be public.
# Find it in Firebase console → Project settings → General → Your apps → Web app.
# For GitHub Pages builds, set these as repository *Variables* (Settings → Secrets
# and variables → Actions → Variables) with the same names.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Default multiplayer server used by Quick Play and room codes.
# The HTTPS website can only reach secure servers, so use wss:// here
# (e.g. wss://play.example.com). Leave empty to let players enter one.
VITE_DEFAULT_SERVER_URL=

# Optional TURN relay for games hosted in a browser. Without it, players connect
# directly (works on most home networks); a relay also lets players on strict
# networks (school, office, some mobile data) connect. These values are PUBLIC:
# they ship in the web build, so use relay credentials intended for browsers,
# e.g. from a free TURN plan. Comma-separate several URLs.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---------------------------------------------------------------------------
# Game server — PRIVATE. Read by `npm run start:server` / `npm run dev:server`.
# ---------------------------------------------------------------------------
# Port and bind address. 0.0.0.0 accepts LAN players; 127.0.0.1 is local-only.
PORT=2567
HOST=0.0.0.0
MAX_ROOMS=50
RECONNECT_SECONDS=45
# Folder with the built web client to serve at /game/ (default: apps/client/dist).
CLIENT_DIST=

# Firebase project id: lets the server verify signed-in players (no secret needed).
FIREBASE_PROJECT_ID=
# Service account JSON — a file path or the JSON itself. SECRET: never commit it,
# never put it in the web client. Enables verified usernames and recorded results.
FIREBASE_SERVICE_ACCOUNT=

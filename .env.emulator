# Local Firebase emulators: `npm run emulators`, then `npm run dev:emulated`.
# These demo values replace the real project's, so nothing reaches the live project.
VITE_FIREBASE_EMULATOR=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-chromashift.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-chromashift
VITE_FIREBASE_APP_ID=demo-app
VITE_FIREBASE_MESSAGING_SENDER_ID=0

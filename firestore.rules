rules_version = '2';

// CHROMASHIFT Firestore rules.
// - Passwords never touch Firestore (Firebase Authentication owns them).
// - Players can only read/write their own private data.
// - Usernames are unique, case-insensitive and claimed exactly once.
// - Verified match results (stats/*) are written only by trusted game servers
//   through the Admin SDK, which bypasses these rules. Clients can never write them.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // The game's owner (plodroid) can look at every account, including its contact email.
    function isAdmin() {
      return signedIn() && request.auth.uid == 'wTN0PHGyT4cdL80qJBGyYJYXZRk1';
    }
    function validUsername(n) {
      return n is string && n.size() >= 3 && n.size() <= 16
        && n.matches('^[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?$');
    }
    function validDisplayName(n) {
      return n is string && n.size() >= 1 && n.size() <= 24;
    }
    function count(n) {
      return (n is int || n is float) && n >= 0 && n < 100000000;
    }
    function validStats(s) {
      return s is map
        && s.keys().hasOnly(['games', 'wins', 'losses', 'draws', 'kills', 'deaths', 'assists', 'paint', 'bestPaint', 'weaponGames'])
        && count(s.games) && count(s.wins) && count(s.losses) && count(s.kills) && count(s.paint)
        && s.wins + s.losses <= s.games
        && s.weaponGames is map && s.weaponGames.size() <= 200;
    }
    function shortId(v) {
      return v is string && v.size() <= 24;
    }
    function validCosmetics(c) {
      return c is map
        && c.keys().hasOnly(['hair', 'hairColor', 'headgear', 'face', 'outfit', 'back', 'accent', 'skin', 'body', 'emote', 'emotes', 'title', 'banner', 'finish'])
        && shortId(c.hair) && shortId(c.headgear) && shortId(c.outfit) && shortId(c.accent) && shortId(c.emote)
        && c.skin is int && c.skin >= 0 && c.skin < 16
        && (!('hairColor' in c) || shortId(c.hairColor))
        && (!('face' in c) || shortId(c.face))
        && (!('back' in c) || shortId(c.back))
        && (!('title' in c) || shortId(c.title))
        && (!('banner' in c) || shortId(c.banner))
        && (!('finish' in c) || shortId(c.finish))
        && (!('body' in c) || c.body in ['f', 'm'])
        && (!('emotes' in c) || (c.emotes is list && c.emotes.size() <= 8));
    }
    function validUser(d) {
      return d.keys().hasOnly(['username', 'usernameKey', 'displayName', 'createdAt', 'updatedAt', 'xp', 'stats', 'weapon', 'special', 'cosmetics', 'settings', 'coins', 'owned', 'favs', 'quests', 'banned'])
        && validUsername(d.username)
        && d.usernameKey == d.username.lower()
        && validDisplayName(d.displayName)
        && count(d.xp)
        && validStats(d.stats)
        && d.weapon is string && d.weapon.size() <= 16
        && d.special is string && d.special.size() <= 16
        && validCosmetics(d.cosmetics)
        && (!('settings' in d) || d.settings is map)
        // Coins are earned and spent on this device (no server to check them on the free plan).
        && (!('coins' in d) || count(d.coins))
        && (!('owned' in d) || (d.owned is list && d.owned.size() <= 6000))
        && (!('favs' in d) || (d.favs is list && d.favs.size() <= 400))
        && (!('quests' in d) || d.quests is map)
        && (!('banned' in d) || d.banned is bool);
    }
    function validStatsCard(s) {
      return s is map && s.keys().hasOnly(['games', 'wins', 'kills', 'paint'])
        && count(s.games) && count(s.wins) && count(s.kills) && count(s.paint);
    }
    function validCard(d) {
      return d.keys().hasOnly(['username', 'usernameKey', 'displayName', 'level', 'cosmetics', 'stats', 'online', 'seenAt', 'activity', 'createdAt', 'updatedAt'])
        && validDisplayName(d.displayName)
        && d.level is int && d.level >= 1 && d.level <= 99
        && validCosmetics(d.cosmetics)
        && (!('usernameKey' in d) || d.usernameKey == d.username.lower())
        && (!('stats' in d) || validStatsCard(d.stats))
        && (!('online' in d) || d.online is bool)
        && (!('activity' in d) || d.activity in ['menu', 'lobby', 'match'])
        && (!('createdAt' in d) || d.createdAt is timestamp);
    }
    // Two account ids joined in order: the id of a friendship or a conversation.
    function pairOf(id) {
      return id.split('_');
    }
    function inPair(id) {
      return signedIn() && pairOf(id).size() == 2 && request.auth.uid in pairOf(id);
    }
    function friends(id) {
      return exists(/databases/$(database)/documents/friendships/$(id))
        && get(/databases/$(database)/documents/friendships/$(id)).data.status == 'accepted';
    }

    // Username registry. Public `get` lets the sign-up form check availability.
    // The registry stores only the uid and display form of the name — never emails.
    match /usernames/{key} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validUsername(request.resource.data.name)
        && key == request.resource.data.name.lower()
        // One username per account: only while creating the account's profile.
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.usernameKey == key;
      allow update: if false;
      allow delete: if isOwner(resource.data.uid);
    }

    // Private profile, settings and offline progression. Owner only.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && validUser(request.resource.data)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameKey)).data.uid == uid;
      allow update: if isOwner(uid)
        && validUser(request.resource.data)
        // The username can't be changed by editing the profile.
        && request.resource.data.username == resource.data.username
        && request.resource.data.usernameKey == resource.data.usernameKey
        && request.resource.data.createdAt == resource.data.createdAt
        // Only the owner can ban or unban.
        && request.resource.data.get('banned', false) == resource.data.get('banned', false)
        // Offline XP is client-reported; cap how fast it can grow per write.
        && request.resource.data.xp <= resource.data.xp + 50000;
      // The owner can edit any account's stats and ban or unban it.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'coins', 'owned', 'stats', 'banned', 'updatedAt']);
      allow delete: if false;
    }

    // Public player card (no email, no private settings). Searchable by username.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid
        && validCard(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.username == resource.data.username
        && validCard(request.resource.data);
      allow delete: if false;
    }

    // The player's own contact email and update preference. Owner only, never public.
    match /private/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'updates', 'updatedAt'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.updates is bool;
    }

    // Friendships: one document per pair, its id the two account ids in order, joined by "_".
    // A request is pending until the other player accepts; either player can end it.
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if inPair(id)
        && request.resource.data.keys().hasOnly(['users', 'requester', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.users == pairOf(id)
        && pairOf(id)[0] < pairOf(id)[1]
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn() && request.auth.uid in resource.data.users
        && request.auth.uid != resource.data.requester
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // In-game notifications: anyone signed in may leave one for a player, signed with their own
    // id; only that player can read, mark or clear them.
    match /notifications/{uid}/items/{id} {
      allow read, delete: if isOwner(uid);
      allow update: if isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if signedIn() && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(['type', 'from', 'fromName', 'party', 'text', 'createdAt', 'expiresAt', 'read'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.type in ['friendRequest', 'friendAccepted', 'partyInvite', 'message']
        && validDisplayName(request.resource.data.fromName)
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 140))
        && request.resource.data.read == false;
    }

    // Parties, keyed by the leader's id. The leader invites; an invite lasts five minutes and lets
    // that player join; members can leave; the leader can share a game everyone follows.
    match /parties/{leader} {
      function invited() {
        return request.auth.uid in resource.data.invites
          && request.time < resource.data.invites[request.auth.uid];
      }
      // The leader may look before the party exists; queries list only parties you're in.
      allow get: if isOwner(leader) || (signedIn() && (request.auth.uid in resource.data.members || request.auth.uid in resource.data.invites));
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if isOwner(leader)
        && request.resource.data.keys().hasOnly(['leader', 'members', 'names', 'invites', 'game', 'updatedAt'])
        && request.resource.data.leader == leader
        && request.resource.data.members == [leader];
      allow update: if signedIn() && request.resource.data.leader == resource.data.leader
        && request.resource.data.members.size() <= 4
        && (
          request.auth.uid == leader
          // Accepting an invite: add yourself, drop the invite.
          || (invited()
            && request.resource.data.members.hasAll(resource.data.members)
            && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'invites', 'updatedAt']))
          // Leaving: remove only yourself.
          || (request.auth.uid in resource.data.members
            && resource.data.members.removeAll(request.resource.data.members).hasOnly([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'updatedAt']))
        );
      allow delete: if isOwner(leader);
    }

    // Direct messages between friends, in a conversation per pair. Voice notes are short
    // recordings stored inline (the free plan has no file storage).
    match /chats/{id} {
      allow get: if inPair(id);
      // Listing conversations is a query on "users"; it can't be checked against the id.
      allow list: if signedIn() && request.auth.uid in resource.data.users;
      allow write: if inPair(id) && friends(id)
        && request.resource.data.keys().hasOnly(['users', 'last', 'updatedAt'])
        && request.resource.data.users == pairOf(id);
      match /messages/{mid} {
        allow read: if inPair(id);
        allow create: if inPair(id) && friends(id)
          && request.resource.data.keys().hasOnly(['from', 'text', 'voice', 'duration', 'createdAt'])
          && request.resource.data.from == request.auth.uid
          && (
            (request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 500)
            || (request.resource.data.voice is string && request.resource.data.voice.size() <= 400000
              && request.resource.data.duration is number && request.resource.data.duration <= 31)
          );
        allow delete: if inPair(id) && resource.data.from == request.auth.uid;
      }
    }

    // Where a player is playing (the code of the game they are in). Only they and the owner can see it.
    match /presence/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && request.resource.data.keys().hasOnly(['code', 'updatedAt'])
        && (request.resource.data.code == null || (request.resource.data.code is string && request.resource.data.code.size() <= 12));
    }

    // The owner's note that they are joining a game (by its code), so that game's host can let them in.
    match /adminJoin/{code} {
      allow read: if signedIn();
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // The owner's weapon config: new weapons, tuned weapons and limited sales. Everyone reads, only the owner writes.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string && request.resource.data.json.size() < 600000;
    }

    // Server-verified online record. Read by the owner; written only via the Admin SDK.
    match /stats/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Public games: a browser-hosted game its host chose to list. Anyone may browse them;
    // a signed-in player may list one game at a time, under their own id, and remove it.
    // Holds only what the game list shows: no email, no account data.
    function validRoom(d) {
      return d.keys().hasOnly(['code', 'name', 'map', 'mode', 'players', 'phase', 'protocol', 'updatedAt'])
        && d.code is string && d.code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{5}$')
        && validDisplayName(d.name)
        && d.map in ['skyline', 'core', 'float', 'docks', 'gardens', 'canyon', 'arcade']
        && d.mode in ['turf', 'zones', 'knockout', 'blitz', 'rush', 'suddendeath', 'brawl']
        && d.players is int && d.players >= 1 && d.players <= 8
        && d.phase in ['lobby', 'match', 'results']
        && d.protocol is int && d.protocol >= 1 && d.protocol <= 1000
        && d.updatedAt == request.time;
    }
    match /rooms/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid) && validRoom(request.resource.data);
      allow delete: if isOwner(uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
